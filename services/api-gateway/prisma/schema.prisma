// Witness — PostgreSQL schema for the Developer Preview.
//
// PostgreSQL is the sole system of record (ADR-0004). Neo4j, OpenSearch and
// pgvector are rebuildable projections and hold no authoritative data; none of
// them appear here because none of them exist yet, and modelling a projection
// before its projector exists would be pretending.
//
// Scope discipline: only the entities the Developer Preview actually uses are
// modelled. Assertion, Evidence, Commitment, Consent and Tenant are all real
// parts of the architecture (architecture/DATA_MODEL.md) and are deliberately
// absent — adding a table nothing writes to is how a schema becomes fiction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Who did something. The human/model distinction is load-bearing: principle P4
/// forbids a model from confirming a record into institutional memory, and that
/// rule is only enforceable if the system can tell them apart.
model Actor {
  id          String   @id @db.Uuid
  kind        String   @db.VarChar(16)
  displayName String   @map("display_name") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  capturedRecords           Record[]           @relation("CapturedBy")
  auditEvents               AuditEvent[]
  evidenceLinks             EvidenceLink[]     @relation("EvidenceLinkCreatedBy")
  reviewAssignmentsAssigned ReviewAssignment[] @relation("ReviewAssignmentAssignedBy")
  clarificationsRequested   Clarification[]    @relation("ClarificationRequestedBy")
  clarificationsResponded   Clarification[]    @relation("ClarificationRespondedBy")
  decisionsProposed         Decision[]         @relation("DecisionProposedBy")
  decisionsConfirmed        Decision[]         @relation("DecisionConfirmedBy")
  commitmentsProposed       Commitment[]       @relation("CommitmentProposedBy")
  commitmentsActivated      Commitment[]       @relation("CommitmentActivatedBy")
  actionItemsCreated        ActionItem[]       @relation("ActionItemCreatedBy")
  outcomeSupportsRecorded   OutcomeSupport[]   @relation("OutcomeSupportRecordedBy")

  @@index([kind])
  @@map("actor")
}

/// Where a record came from. Provenance starts here (principle P3).
model Source {
  id         String   @id @db.Uuid
  kind       String   @db.VarChar(32)
  label      String   @db.VarChar(300)
  /// When the source material was created — NOT when Witness ingested it.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  records Record[]

  @@index([occurredAt])
  @@map("source")
}

/// A piece of institutional memory.
///
/// `sourceId` and `capturedById` are NOT NULL by design. A record without
/// provenance is exactly what principle P3 forbids, and the database is the last
/// line of defence for an invariant the application already enforces — because
/// applications get rewritten and this constraint should outlive them.
model Record {
  id          String @id @db.Uuid
  title       String @db.VarChar(200)
  body        String @db.Text
  reviewState String @map("review_state") @db.VarChar(24)

  sourceId String @map("source_id") @db.Uuid
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  capturedById String @map("captured_by_id") @db.Uuid
  capturedBy   Actor  @relation("CapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)

  capturedAt DateTime @map("captured_at") @db.Timestamptz(6)

  /// Consent grant authorising processing (P2). Nullable ONLY because the consent
  /// service does not exist yet — Phase 3, roadmap 3.4. It becomes NOT NULL then,
  /// and that migration is expected to be the hard one.
  consentGrantId String? @map("consent_grant_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([reviewState])
  @@index([capturedAt])
  @@map("record")
}

/// The tenant boundary (BUILD_ROADMAP.md, Release 0.2, item 1).
///
/// Deliberately minimal: this Developer Preview only covers creation. Membership
/// and multi-tenant scoping of Record/Source are later roadmap items — modelling
/// them now, before anything reads or writes them, would be fiction.
model Organisation {
  id        String   @id @db.Uuid
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspaces                   Workspace[]
  memberships                  OrganisationMembership[]
  roleAssignments              RoleAssignment[]
  coDesignSessions             CoDesignSession[]
  sessionParticipants          SessionParticipant[]
  consentTemplates             ConsentTemplate[]
  sessionConsentConfigurations SessionConsentConfiguration[]
  participantConsentRecords    ParticipantConsentRecord[]
  evidence                     Evidence[]
  evidenceLinks                EvidenceLink[]
  reviewAssignments            ReviewAssignment[]
  clarifications               Clarification[]
  decisions                    Decision[]
  commitments                  Commitment[]
  actionItems                  ActionItem[]
  outcomeSupports              OutcomeSupport[]

  @@map("organisation")
}

/// A scoped working area inside an organisation (BUILD_ROADMAP.md, Release 0.2,
/// item 2). Sessions, participants and records are scoped to a workspace in
/// later roadmap items (6, 7, 9) — not yet, since none of those exist here.
///
/// Unlike `AuditEvent.subjectId`, this is a real foreign key: a workspace always
/// belongs to exactly one organisation, never a polymorphic set of parents, so
/// there is no reason to give up referential integrity here.
model Workspace {
  id   String @id @db.Uuid
  name String @db.VarChar(200)

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships                  WorkspaceMembership[]
  roleAssignments              RoleAssignment[]
  coDesignSessions             CoDesignSession[]
  sessionParticipants          SessionParticipant[]
  consentTemplates             ConsentTemplate[]
  sessionConsentConfigurations SessionConsentConfiguration[]
  participantConsentRecords    ParticipantConsentRecord[]
  evidence                     Evidence[]
  evidenceLinks                EvidenceLink[]
  reviewAssignments            ReviewAssignment[]
  clarifications               Clarification[]
  decisions                    Decision[]
  commitments                  Commitment[]
  actionItems                  ActionItem[]
  outcomeSupports              OutcomeSupport[]

  @@index([organisationId])
  @@map("workspace")
}

/// A registered Witness account (BUILD_ROADMAP.md Milestone 1.1, Users and
/// Memberships). Deliberately independent of `Actor` — see `packages/domain/src/user.ts`
/// for why the two concepts do not merge yet.
///
/// The table is mapped to `witness_user` rather than `user`: Prisma always
/// quotes identifiers so the SQL keyword conflict is not a functional problem,
/// but every other model here reads cleanly as an unquoted `SELECT * FROM x`
/// and there is no reason this one shouldn't too.
model User {
  id           String   @id @db.Uuid
  email        String   @unique @db.VarChar(320)
  displayName  String   @map("display_name") @db.VarChar(200)
  accountState String   @map("account_state") @db.VarChar(24)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisationMemberships   OrganisationMembership[]
  workspaceMemberships      WorkspaceMembership[]
  roleAssignments           RoleAssignment[]
  identityLinks             IdentityLink[]
  authSessions              AuthSession[]
  facilitatedSessions       CoDesignSession[]
  linkedSessionParticipants SessionParticipant[]
  reviewAssignments         ReviewAssignment[]       @relation("ReviewAssignmentReviewer")
  ownedCommitments          Commitment[]             @relation("CommitmentOwner")
  ownedActionItems          ActionItem[]             @relation("ActionItemOwner")

  @@index([accountState])
  @@map("witness_user")
}

/// The stable connection between an external identity provider's subject and
/// a Witness user (BUILD_ROADMAP.md Milestone 1.3, Authentication). See
/// `packages/domain/src/identity-link.ts` for why this is keyed on
/// `(provider, providerSubject)` rather than email.
model IdentityLink {
  id              String @id @db.Uuid
  provider        String @db.VarChar(32)
  providerSubject String @map("provider_subject") @db.VarChar(255)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  linkedAt     DateTime  @map("linked_at") @db.Timestamptz(6)
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamptz(6)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("identity_link")
}

/// A signed-in session. `tokenHash` is a SHA-256 hash of the opaque bearer
/// token handed to the browser — the raw token is never persisted, the same
/// reasoning as never storing a password: a database read must not be
/// enough to impersonate a session.
///
/// Delivered as a bearer token rather than a cookie deliberately: the
/// browser already calls the API directly, cross-origin, from a different
/// port (`main.ts`'s CORS configuration predates this capability) — a
/// cross-site cookie would need `SameSite=None; Secure`, which requires
/// HTTPS everywhere including local development. A bearer token sent via
/// `Authorization` header (mirroring the existing, now-superseded-in-
/// production `X-Witness-Dev-User` header shape) avoids that without
/// changing the application's deployment topology.
model AuthSession {
  id        String @id @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_session")
}

/// A single in-flight OIDC authorization-code-with-PKCE exchange. Short-lived
/// and single-use — the row is deleted the moment the callback completes or
/// fails, so it is intentionally not modelled with the same permanence as
/// everything else in this file. State is stored server-side (rather than
/// signed and round-tripped through the browser) so the callback verifies
/// against something Witness itself wrote, not something it merely trusts a
/// redirect to still contain.
model AuthLoginAttempt {
  /// The OIDC `state` parameter — a high-entropy value the callback must
  /// present unchanged.
  state        String @id @db.VarChar(64)
  nonce        String @db.VarChar(64)
  codeVerifier String @map("code_verifier") @db.VarChar(128)
  redirectUri  String @map("redirect_uri") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("auth_login_attempt")
}

/// "Does this user belong to this organisation" — nothing about what they may
/// do there (that is Milestone 1.2, Roles and Permission Assignment).
///
/// The unique constraint on (organisationId, userId) is the enforcement point
/// for "a user must not have duplicate active membership records for the same
/// organisation": a membership is one row per (organisation, user) pair for
/// its whole lifecycle, transitioning state rather than being recreated.
model OrganisationMembership {
  id             String       @id @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  state String @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organisationId, userId])
  @@index([organisationId, state])
  @@index([userId])
  @@map("organisation_membership")
}

/// "Does this user belong to this workspace". A real foreign key to `Workspace`
/// and `User` — same reasoning as `Workspace.organisationId` — because a
/// workspace membership always has exactly one workspace and one user.
///
/// Nothing here enforces "the user has a valid relationship with the
/// workspace's parent organisation" at the database level — that check reads
/// the user's `OrganisationMembership` for the workspace's `organisationId`,
/// which spans two tables Postgres cannot express as a single constraint. It is
/// enforced in `packages/domain/src/workspace-membership.ts` and the service
/// that reads the organisation membership before calling in.
model WorkspaceMembership {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  state String @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceId, userId])
  @@index([workspaceId, state])
  @@index([userId])
  @@map("workspace_membership")
}

/// "What may this member do here" (BUILD_ROADMAP.md Milestone 1.2, Roles and
/// Permission Assignment) — strictly separate from `OrganisationMembership`/
/// `WorkspaceMembership`, which only answer "does this member belong here".
///
/// One row per (user, scope): `organisationId`/`workspaceId` are mutually
/// exclusive per `scopeType`, enforced by the `role_assignment_scope_check`
/// CHECK constraint added in this model's migration (Prisma's schema DSL has
/// no way to express it directly). The two `@@unique` constraints below give
/// an independent "one row per (organisation, user)" and "one row per
/// (workspace, user)" without a partial index, because Postgres never treats
/// NULL as equal to NULL in a unique constraint — multiple workspace-scoped
/// rows (organisationId = NULL) do not collide with each other, and vice
/// versa.
///
/// Deliberately does not duplicate membership data (state, timestamps) —
/// only the identifiers needed to scope and query the assignment itself; the
/// membership tables above remain the sole source of truth for "in good
/// standing", re-read by the service layer at assignment time
/// (`packages/domain/src/role-assignment.ts`).
model RoleAssignment {
  id        String @id @db.Uuid
  scopeType String @map("scope_type") @db.VarChar(16)

  organisationId String?       @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String?    @map("workspace_id") @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  role String @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organisationId, userId])
  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("role_assignment")
}

/// A co-design workshop, consultation, or similar structured conversation
/// (BUILD_ROADMAP.md Milestone 2) — the first core product capability after
/// identity and access management. Scoped to exactly one organisation and
/// workspace, mirroring `Workspace.organisationId`: a real foreign key, not
/// a polymorphic association, because a session always belongs to exactly
/// one workspace under exactly one organisation.
///
/// `createdBy` is deliberately NOT a column here — same convention as
/// `Organisation`/`Workspace`: who created it is recorded once, on the
/// `co_design_session.created` audit event, not duplicated onto the row
/// itself. `primaryFacilitatorId` IS a column because it is live business
/// data a session can reassign (`co_design_session.facilitator_changed`),
/// not a point-in-time provenance fact.
///
/// `version` backs optimistic concurrency: a concurrent update supplies the
/// version it last read, and the service layer's conditional update
/// (`WHERE id = ? AND version = ?`) rejects a write based on stale data
/// rather than silently overwriting a change it never saw.
model CoDesignSession {
  id             String       @id @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  title       String  @db.VarChar(200)
  purpose     String  @db.Text
  description String? @db.Text

  sessionType  String  @map("session_type") @db.VarChar(100)
  location     String? @db.VarChar(300)
  deliveryMode String  @map("delivery_mode") @db.VarChar(24)

  startAt  DateTime? @map("start_at") @db.Timestamptz(6)
  endAt    DateTime? @map("end_at") @db.Timestamptz(6)
  timezone String?   @db.VarChar(64)

  primaryFacilitatorId String @map("primary_facilitator_id") @db.Uuid
  primaryFacilitator   User   @relation(fields: [primaryFacilitatorId], references: [id], onDelete: Restrict)

  status String @db.VarChar(16)

  supportedLanguages        String[] @default([]) @map("supported_languages")
  culturalProtocolNotes     String?  @map("cultural_protocol_notes") @db.Text
  participantVisibility     String   @map("participant_visibility") @db.VarChar(32)
  consentConfigurationState String   @default("not_configured") @map("consent_configuration_state") @db.VarChar(24)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  openedAt   DateTime? @map("opened_at") @db.Timestamptz(6)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  version Int @default(1)

  participants              SessionParticipant[]
  consentConfiguration      SessionConsentConfiguration?
  participantConsentRecords ParticipantConsentRecord[]
  evidence                  Evidence[]
  evidenceLinks             EvidenceLink[]
  reviewAssignments         ReviewAssignment[]
  clarifications            Clarification[]
  decisions                 Decision[]
  commitments               Commitment[]
  actionItems               ActionItem[]
  outcomeSupports           OutcomeSupport[]

  @@index([organisationId])
  @@index([workspaceId, status])
  @@index([primaryFacilitatorId])
  @@map("co_design_session")
}

/// Who is part of a co-design session (BUILD_ROADMAP.md Milestone 3,
/// Participant Management). `linkedUserId` is nullable and independent of
/// `identityMode` — a participant is never required to hold a Witness user
/// account, and a registered user may still participate pseudonymously.
///
/// `facilitatorNotes` is restricted: the API layer only ever includes it in
/// a response for a caller holding `participant:manage_restricted`.
///
/// A partial unique index on `(sessionId, linkedUserId)` — WHERE
/// `linkedUserId` IS NOT NULL — stops a registered user being linked to the
/// same session twice. Prisma's schema DSL cannot express a partial index,
/// so it lives only in the migration SQL (same convention as
/// `co_design_session_status_check` above).
model SessionParticipant {
  id             String       @id @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sessionId String          @map("session_id") @db.Uuid
  session   CoDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  linkedUserId String? @map("linked_user_id") @db.Uuid
  linkedUser   User?   @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)

  displayName   String  @map("display_name") @db.VarChar(200)
  preferredName String? @map("preferred_name") @db.VarChar(200)
  pronouns      String? @db.VarChar(50)
  affiliation   String? @db.VarChar(300)

  participantType    String @map("participant_type") @db.VarChar(100)
  participationMode  String @map("participation_mode") @db.VarChar(24)
  identityMode       String @map("identity_mode") @db.VarChar(24)
  identityVisibility String @map("identity_visibility") @db.VarChar(32)

  languagePreference        String? @map("language_preference") @db.VarChar(50)
  accessibilityRequirements String? @map("accessibility_requirements") @db.Text

  invitationStatus String @map("invitation_status") @db.VarChar(16)
  attendanceStatus String @map("attendance_status") @db.VarChar(20)

  consentStatusSummary String @default("not_configured") @map("consent_status_summary") @db.VarChar(24)

  /// Restricted — see model doc comment above.
  facilitatorNotes String? @map("facilitator_notes") @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(6)

  version Int @default(1)

  consentRecords ParticipantConsentRecord[]
  evidence       Evidence[]

  @@index([sessionId])
  @@index([workspaceId])
  @@index([linkedUserId])
  @@map("session_participant")
}

/// A versioned, organisation-defined consent statement (BUILD_ROADMAP.md
/// Milestone 4, Consent Management). Each row IS one immutable version —
/// there is no update path in the application (`packages/domain/src/consent-template.ts`
/// has no "edit template" function), so "template versions must be
/// immutable once used by a session" is enforced structurally rather than by
/// a runtime guard.
///
/// `familyId` groups every version of "the same template" conceptually.
/// It is a plain string, not a foreign key to anything, because a family is
/// not itself a row — it is a shared label `createNewTemplateVersion`
/// copies onto each new row. The `(family_id, version)` unique constraint is
/// the database's own backstop against two rows ever claiming the same
/// version number within a family, mirroring the "last line of defence"
/// role other CHECK/UNIQUE constraints play elsewhere in this schema.
///
/// `categories` is stored as JSONB — an ordered list of
/// `{ category, required }` objects — because Postgres has no native array-
/// of-object column type and the set is read as a whole by the domain layer,
/// never queried by individual category from SQL.
model ConsentTemplate {
  id       String @id @db.Uuid
  familyId String @map("family_id") @db.VarChar(64)

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String?    @map("workspace_id") @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  name        String  @db.VarChar(200)
  purpose     String  @db.Text
  description String? @db.Text

  version Int
  status  String @db.VarChar(16)

  plainLanguageSummary String   @map("plain_language_summary") @db.Text
  supportedLanguages   String[] @default([]) @map("supported_languages")

  /// `ConsentTemplateCategory[]` — see the model doc comment above.
  categories Json

  validFrom  DateTime? @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic-concurrency counter; bumped on every status transition.
  revision Int @default(1)

  sessionConsentConfigurations SessionConsentConfiguration[]
  participantConsentRecords    ParticipantConsentRecord[]

  @@unique([familyId, version])
  @@index([organisationId])
  @@index([workspaceId])
  @@map("consent_template")
}

/// Which `ConsentTemplate` version a session uses, and which of that
/// template's categories are required or optional for this specific session
/// (BUILD_ROADMAP.md Milestone 4). A session has at most one configuration
/// at a time — `session_id` is unique, and reconfiguring updates the row in
/// place with optimistic concurrency, rather than versioning the
/// configuration itself the way `ConsentTemplate` is versioned.
model SessionConsentConfiguration {
  id String @id @db.Uuid

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sessionId String          @unique @map("session_id") @db.Uuid
  session   CoDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  consentTemplateId String          @map("consent_template_id") @db.Uuid
  consentTemplate   ConsentTemplate @relation(fields: [consentTemplateId], references: [id], onDelete: Restrict)
  templateVersion   Int             @map("template_version")

  requiredCategories String[] @map("required_categories")
  optionalCategories String[] @default([]) @map("optional_categories")

  facilitatorInstructions String? @map("facilitator_instructions") @db.Text
  participantIntroduction String? @map("participant_introduction") @db.Text

  effectiveDate DateTime @map("effective_date") @db.Timestamptz(6)
  status        String   @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic-concurrency counter; bumped on every reconfiguration.
  version Int @default(1)

  @@index([organisationId])
  @@index([workspaceId])
  @@index([consentTemplateId])
  @@map("session_consent_configuration")
}

/// One participant's category-level consent decisions, captured against a
/// specific, immutable `ConsentTemplate` version (BUILD_ROADMAP.md
/// Milestone 4). Consent decisions are never overwritten — there is no
/// "edit consent record" function in the domain layer; amending a
/// participant's consent is two coordinated writes the service layer
/// performs together: the old record is marked `superseded_by_record_id`,
/// and a fresh record is captured with `amends_record_id` pointing back at
/// it. Both `amends_record_id` and `superseded_by_record_id` are therefore
/// self-referencing foreign keys, given distinct relation names because
/// Prisma requires one name per self-relation on the same model.
///
/// `withdrawal_reason` is restricted — the API layer only includes it in a
/// response for a caller holding `participant_consent:manage_restricted`,
/// the same convention `session_participant.facilitator_notes` already
/// established.
///
/// `category_decisions` is stored as JSONB for the same reason
/// `ConsentTemplate.categories` is: an ordered list of
/// `{ category, granted }` objects, read as a whole by the domain layer.
model ParticipantConsentRecord {
  id String @id @db.Uuid

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sessionId String          @map("session_id") @db.Uuid
  session   CoDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  participantId String             @map("participant_id") @db.Uuid
  participant   SessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  consentTemplateId String          @map("consent_template_id") @db.Uuid
  consentTemplate   ConsentTemplate @relation(fields: [consentTemplateId], references: [id], onDelete: Restrict)
  templateVersion   Int             @map("template_version")

  /// `ConsentCategoryDecision[]` — see the model doc comment above.
  categoryDecisions Json @map("category_decisions")

  captureMethod String  @map("capture_method") @db.VarChar(100)
  language      String? @db.VarChar(50)

  capturedAt DateTime  @map("captured_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)

  amendsRecordId String?                    @map("amends_record_id") @db.Uuid
  amendsRecord   ParticipantConsentRecord?  @relation("ConsentRecordAmendment", fields: [amendsRecordId], references: [id], onDelete: SetNull)
  amendedBy      ParticipantConsentRecord[] @relation("ConsentRecordAmendment")

  supersededByRecordId String?                    @map("superseded_by_record_id") @db.Uuid
  supersededBy         ParticipantConsentRecord?  @relation("ConsentRecordSupersession", fields: [supersededByRecordId], references: [id], onDelete: SetNull)
  supersedes           ParticipantConsentRecord[] @relation("ConsentRecordSupersession")

  withdrawnAt      DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  /// Restricted — see the model doc comment above.
  withdrawalReason String?   @map("withdrawal_reason") @db.Text

  acknowledgementReference String? @map("acknowledgement_reference") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic-concurrency counter; bumped on withdrawal or superseding.
  version Int @default(1)

  @@index([sessionId])
  @@index([participantId])
  @@index([workspaceId])
  @@index([consentTemplateId])
  @@map("participant_consent_record")
}

/// A single structured piece of evidence captured during an open co-design
/// session (BUILD_ROADMAP.md Milestone 5, Structured Live Evidence Capture).
/// See `packages/domain/src/evidence.ts`'s file header for the full design
/// reasoning — this model exists to store, not to decide.
///
/// `evidenceType` is `VARCHAR`, not an enum: `EVIDENCE_TYPES` in the domain
/// is a suggested vocabulary, not a closed gate, the same convention
/// `session_participant.participant_type` already established.
///
/// `reviewStatus` stores the full seven-state vocabulary from the start
/// (`draft`/`submitted`/`under_review`/`needs_clarification`/`validated`/
/// `rejected`/`withdrawn`) even though Milestone 5's domain layer only
/// transitions between three of them — the column must not need a migration
/// when Milestone 6 adds the rest.
///
/// `sourceParticipantId` is nullable and deliberately has no CHECK tying it
/// to `attributionMode` — the domain's `assertAttributionCompatibility`
/// enforces that relationship, and Postgres CHECK constraints cannot express
/// "this column is null if and only if that column is one of these values"
/// without a trigger, which would duplicate logic across two layers for a
/// rule the domain layer already owns exclusively per ADR-0003.
///
/// `consentBasis` and `tags` are `String[]`, not JSONB: both are flat lists
/// of short strings the application reads and writes whole, never queried by
/// element from SQL, so a native array column is the simpler fit — unlike
/// `ConsentTemplate.categories`, which is a list of *objects*.
///
/// `withdrawalReason` is restricted, the same convention every other
/// restricted-field column in this schema follows: the API layer only
/// includes it in a response for a caller holding `evidence:manage_restricted`.
model Evidence {
  id String @id @db.Uuid

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sessionId String          @map("session_id") @db.Uuid
  session   CoDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  evidenceType String  @map("evidence_type") @db.VarChar(100)
  title        String  @db.VarChar(300)
  content      String  @db.Text
  language     String? @db.VarChar(50)

  capturedAt           DateTime @map("captured_at") @db.Timestamptz(6)
  sessionOffsetSeconds Int?     @map("session_offset_seconds")

  sourceParticipantId String?             @map("source_participant_id") @db.Uuid
  sourceParticipant   SessionParticipant? @relation(fields: [sourceParticipantId], references: [id], onDelete: SetNull)

  attributionMode    String @map("attribution_mode") @db.VarChar(32)
  identityVisibility String @map("identity_visibility") @db.VarChar(32)

  /// Consent categories checked and allowed at capture time — a snapshot,
  /// not a live reference. See `packages/domain/src/evidence.ts`'s file
  /// header for why.
  consentBasis String[] @default([]) @map("consent_basis")

  reviewStatus       String @default("draft") @map("review_status") @db.VarChar(24)
  verificationStatus String @default("unverified") @map("verification_status") @db.VarChar(16)

  tags String[] @default([])

  supersededByEvidenceId String?    @map("superseded_by_evidence_id") @db.Uuid
  supersededBy           Evidence?  @relation("EvidenceSupersession", fields: [supersededByEvidenceId], references: [id], onDelete: SetNull)
  supersedes             Evidence[] @relation("EvidenceSupersession")

  withdrawnAt      DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  /// Restricted — see the model doc comment above.
  withdrawalReason String?   @map("withdrawal_reason") @db.Text

  /// The reviewer's stated reason for the most recent validate/reject
  /// decision (BUILD_ROADMAP.md Milestone 6). Null until a decision has
  /// been made.
  reviewDecisionReason String? @map("review_decision_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic-concurrency counter; bumped on every mutation.
  version Int @default(1)

  linksFrom         EvidenceLink[]     @relation("EvidenceLinkFrom")
  linksTo           EvidenceLink[]     @relation("EvidenceLinkTo")
  reviewAssignments ReviewAssignment[]
  clarifications    Clarification[]
  outcomeSupports   OutcomeSupport[]   @relation("OutcomeSupportEvidence")

  @@index([sessionId])
  @@index([workspaceId])
  @@index([sourceParticipantId])
  @@index([sessionId, reviewStatus])
  @@map("evidence")
}

/// A typed relationship between two pieces of `Evidence` within the same
/// session (BUILD_ROADMAP.md Milestone 5). See
/// `packages/domain/src/evidence-link.ts`'s file header for why this is a
/// genuine delete rather than a withdrawal, unlike `Evidence` itself.
///
/// The unique constraint on `(fromEvidenceId, toEvidenceId, linkType)` is
/// the database's own backstop against the same relationship being recorded
/// twice — the domain layer cannot check this itself (ADR-0003; it would
/// need a database read), so `EvidenceLinkService` checks it first and this
/// constraint is the last line of defence if that check is ever bypassed.
model EvidenceLink {
  id String @id @db.Uuid

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sessionId String          @map("session_id") @db.Uuid
  session   CoDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  linkType String @map("link_type") @db.VarChar(24)

  fromEvidenceId String   @map("from_evidence_id") @db.Uuid
  fromEvidence   Evidence @relation("EvidenceLinkFrom", fields: [fromEvidenceId], references: [id], onDelete: Cascade)

  toEvidenceId String   @map("to_evidence_id") @db.Uuid
  toEvidence   Evidence @relation("EvidenceLinkTo", fields: [toEvidenceId], references: [id], onDelete: Cascade)

  note String? @db.Text

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String   @map("created_by_id") @db.Uuid
  createdBy   Actor    @relation("EvidenceLinkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([fromEvidenceId, toEvidenceId, linkType])
  @@index([sessionId])
  @@index([toEvidenceId])
  @@map("evidence_link")
}

/// Who is reviewing a specific piece of evidence, and where that review
/// currently stands (BUILD_ROADMAP.md Milestone 6, Evidence Review and
/// Validation). See `packages/domain/src/review-assignment.ts`'s file
/// header for why this is its own aggregate rather than a column on
/// `Evidence`.
///
/// The MVP supports exactly one *active* assignment per evidence at a time.
/// `EvidenceReviewService` checks this before creating a new assignment,
/// but it cannot be trusted to be the only enforcement point, so the
/// partial unique index on `(evidence_id) WHERE status IN ('assigned',
/// 'in_progress')` — expressible only in migration SQL, not this DSL, same
/// convention as `session_participant`'s `linked_user_id` partial index —
/// is the last line of defence.
model ReviewAssignment {
  id String @id @db.Uuid

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sessionId String          @map("session_id") @db.Uuid
  session   CoDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  evidenceId String   @map("evidence_id") @db.Uuid
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  reviewerUserId String @map("reviewer_user_id") @db.Uuid
  reviewerUser   User   @relation("ReviewAssignmentReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  assignedById String @map("assigned_by_id") @db.Uuid
  assignedBy   Actor  @relation("ReviewAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  assignedAt  DateTime  @map("assigned_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  status String @db.VarChar(16)

  /// The prior assignment this one replaces, when created by reassignment.
  /// The prior row itself is never deleted.
  reassignedFromId String?            @map("reassigned_from_id") @db.Uuid
  reassignedFrom   ReviewAssignment?  @relation("ReviewAssignmentReassignment", fields: [reassignedFromId], references: [id], onDelete: SetNull)
  reassignedTo     ReviewAssignment[] @relation("ReviewAssignmentReassignment")

  /// Why this assignment was cancelled or reassigned away from.
  closeReason String? @map("close_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic-concurrency counter; bumped on every mutation.
  version Int @default(1)

  clarifications Clarification[]

  @@index([sessionId])
  @@index([evidenceId])
  @@index([reviewerUserId])
  @@index([reassignedFromId])
  @@map("review_assignment")
}

/// A reviewer's question about a specific piece of evidence, and the answer
/// (if any) that resolves it (BUILD_ROADMAP.md Milestone 6, Evidence Review
/// and Validation). See `packages/domain/src/clarification.ts`'s file
/// header for why this is its own aggregate rather than a comment thread
/// bolted onto `Evidence`.
model Clarification {
  id String @id @db.Uuid

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sessionId String          @map("session_id") @db.Uuid
  session   CoDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  evidenceId String   @map("evidence_id") @db.Uuid
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  reviewAssignmentId String           @map("review_assignment_id") @db.Uuid
  /// Cascade, not Restrict: `Clarification.evidence` and
  /// `ReviewAssignment.evidence` both cascade from `Evidence`, and Postgres
  /// does not guarantee the order it applies them. A Restrict here could
  /// abort an `Evidence` delete part-way through its own cascade, depending
  /// on which side Postgres reached first. A clarification cannot outlive the
  /// assignment that produced it anyway.
  reviewAssignment   ReviewAssignment @relation(fields: [reviewAssignmentId], references: [id], onDelete: Cascade)

  question String @db.Text

  requestedById String   @map("requested_by_id") @db.Uuid
  requestedBy   Actor    @relation("ClarificationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  requestedAt   DateTime @map("requested_at") @db.Timestamptz(6)

  response String? @db.Text

  respondedById String?   @map("responded_by_id") @db.Uuid
  respondedBy   Actor?    @relation("ClarificationRespondedBy", fields: [respondedById], references: [id], onDelete: Restrict)
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz(6)

  status String @db.VarChar(16)

  /// Why this was withdrawn or closed without an answer, when applicable.
  closeReason String? @map("close_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic-concurrency counter; bumped on every mutation.
  version Int @default(1)

  @@index([sessionId])
  @@index([evidenceId])
  @@index([reviewAssignmentId])
  @@map("clarification")
}

/// Append-only, hash-chained audit trail (roadmap 3.7).
///
/// `subjectType` + `subjectId` is a polymorphic association rather than a foreign
/// key to a single table, because the same tamper-evident chain now serves more
/// than one aggregate (Record, Organisation, and more as the roadmap adds
/// aggregates). Postgres cannot express "references exactly one of these tables"
/// as a constraint, so referential integrity here is enforced by the application
/// layer, the same way append-only itself already is — tracked, not forgotten.
///
/// There is deliberately no update or delete path in the application.
model AuditEvent {
  id          String @id @db.Uuid
  subjectType String @map("subject_type") @db.VarChar(24)
  subjectId   String @map("subject_id") @db.Uuid

  action String @db.VarChar(64)

  actorId String @map("actor_id") @db.Uuid
  actor   Actor  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)

  /// Null only for the first event in a subject's chain.
  previousHash String? @map("previous_hash") @db.VarChar(64)
  hash         String  @unique @db.VarChar(64)

  /// Context only — never record content. The audit log answers "who did what,
  /// when", and is retained under a different policy from the content itself.
  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectType, subjectId, occurredAt])
  @@map("audit_event")
}

/// Something a session decided (BUILD_ROADMAP.md Milestone 7, Decisions,
/// Commitments and Actions). See `packages/domain/src/decision.ts`'s file
/// header for why `superseded` and `reversed` are distinct terminal states
/// and why neither deletes anything.
///
/// A decision becomes institutional record only on confirmation, and
/// confirmation requires at least one `OutcomeSupport` row. That count is a
/// database read, so the domain cannot perform it (ADR-0003) —
/// `DecisionService` loads the support rows inside the same transaction and
/// hands them to `confirmDecision`.
model Decision {
  id String @id @db.Uuid

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sessionId String          @map("session_id") @db.Uuid
  session   CoDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  title     String @db.VarChar(300)
  statement String @db.Text

  status String @default("proposed") @db.VarChar(16)

  proposedById String   @map("proposed_by_id") @db.Uuid
  proposedBy   Actor    @relation("DecisionProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  proposedAt   DateTime @map("proposed_at") @db.Timestamptz(6)

  confirmedById String?   @map("confirmed_by_id") @db.Uuid
  confirmedBy   Actor?    @relation("DecisionConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(6)

  /// The decision that replaced this one. `SetNull` rather than `Cascade`:
  /// losing the replacement must never take the superseded decision with it.
  supersededByDecisionId String?    @map("superseded_by_decision_id") @db.Uuid
  supersededBy           Decision?  @relation("DecisionSupersession", fields: [supersededByDecisionId], references: [id], onDelete: SetNull)
  supersedes             Decision[] @relation("DecisionSupersession")
  supersededAt           DateTime?  @map("superseded_at") @db.Timestamptz(6)

  reversedAt DateTime? @map("reversed_at") @db.Timestamptz(6)

  /// Why this was superseded or reversed. Required for a reversal — the
  /// domain enforces that; the column is nullable because a proposed or
  /// confirmed decision has no close reason yet.
  closeReason String? @map("close_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic-concurrency counter; bumped on every mutation.
  version Int @default(1)

  @@index([sessionId])
  @@index([workspaceId])
  @@index([sessionId, status])
  @@index([supersededByDecisionId])
  @@map("decision")
}

/// An undertaking somebody gave in a session (BUILD_ROADMAP.md Milestone 7).
/// See `packages/domain/src/commitment.ts`'s file header for why ownership is
/// two-part: `ownerDescription` is always present and in plain language,
/// because the owner is frequently a team or an agency rather than a Witness
/// account, and because naming a *participant* as owner would defeat the
/// anonymity guarantees Milestone 4 established.
model Commitment {
  id String @id @db.Uuid

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sessionId String          @map("session_id") @db.Uuid
  session   CoDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  title       String @db.VarChar(300)
  description String @db.Text

  status String @default("proposed") @db.VarChar(16)

  ownerDescription String  @map("owner_description") @db.VarChar(300)
  ownerUserId      String? @map("owner_user_id") @db.Uuid
  ownerUser        User?   @relation("CommitmentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  dueDate DateTime? @map("due_date") @db.Timestamptz(6)

  proposedById String   @map("proposed_by_id") @db.Uuid
  proposedBy   Actor    @relation("CommitmentProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  proposedAt   DateTime @map("proposed_at") @db.Timestamptz(6)

  activatedById String?   @map("activated_by_id") @db.Uuid
  activatedBy   Actor?    @relation("CommitmentActivatedBy", fields: [activatedById], references: [id], onDelete: Restrict)
  activatedAt   DateTime? @map("activated_at") @db.Timestamptz(6)

  fulfilledAt    DateTime? @map("fulfilled_at") @db.Timestamptz(6)
  /// How the commitment was met, recorded at fulfilment rather than inferred.
  fulfilmentNote String?   @map("fulfilment_note") @db.Text

  supersededByCommitmentId String?      @map("superseded_by_commitment_id") @db.Uuid
  supersededBy             Commitment?  @relation("CommitmentSupersession", fields: [supersededByCommitmentId], references: [id], onDelete: SetNull)
  supersedes               Commitment[] @relation("CommitmentSupersession")

  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  closeReason String?   @map("close_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic-concurrency counter; bumped on every mutation.
  version Int @default(1)

  @@index([sessionId])
  @@index([workspaceId])
  @@index([sessionId, status])
  @@index([ownerUserId])
  @@index([supersededByCommitmentId])
  @@map("commitment")
}

/// A concrete task carrying a decision or commitment into effect
/// (BUILD_ROADMAP.md Milestone 7). See `packages/domain/src/action-item.ts`'s
/// file header for why an action deliberately does not require
/// `OutcomeSupport`: an action is *how* an institution acts on a decision,
/// not an institutional claim in its own right.
model ActionItem {
  id String @id @db.Uuid

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sessionId String          @map("session_id") @db.Uuid
  session   CoDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  title       String @db.VarChar(300)
  description String @db.Text

  status   String @default("open") @db.VarChar(16)
  priority String @default("medium") @db.VarChar(16)

  /// Same two-part ownership as `Commitment`, for the same reasons.
  ownerDescription String  @map("owner_description") @db.VarChar(300)
  ownerUserId      String? @map("owner_user_id") @db.Uuid
  ownerUser        User?   @relation("ActionItemOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  dueDate DateTime? @map("due_date") @db.Timestamptz(6)

  /// 0–100, advisory. `status` is what actually says whether this is done;
  /// the range is enforced by a check constraint in the migration as well as
  /// by the domain.
  percentComplete Int     @default(0) @map("percent_complete")
  progressNote    String? @map("progress_note") @db.Text
  blockedReason   String? @map("blocked_reason") @db.Text

  createdById String @map("created_by_id") @db.Uuid
  createdBy   Actor  @relation("ActionItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  closeReason String?   @map("close_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic-concurrency counter; bumped on every mutation.
  version Int @default(1)

  @@index([sessionId])
  @@index([workspaceId])
  @@index([sessionId, status])
  @@index([ownerUserId])
  @@map("action_item")
}

/// What an institutional outcome rests on (BUILD_ROADMAP.md Milestone 7). See
/// `packages/domain/src/outcome-support.ts`'s file header for why there are
/// exactly two admissible bases and why the evidence link freezes the version
/// and verification status it saw.
///
/// `outcomeType` + `outcomeId` is a polymorphic association, the same shape
/// and the same trade-off as `AuditEvent.subjectType`/`subjectId`: Postgres
/// cannot express "references exactly one of these three tables", so the
/// application layer enforces it — `OutcomeSupportService` resolves the
/// outcome before writing, and the `sessionId` cascade means support rows
/// cannot outlive the session their outcome belongs to.
///
/// The partial unique index on `(outcome_type, outcome_id, evidence_id)
/// WHERE evidence_id IS NOT NULL` — expressible only in migration SQL, not
/// this DSL — stops the same piece of evidence being counted twice for one
/// outcome. Synthesis rows are deliberately exempt: an outcome may rest on
/// more than one line of institutional reasoning.
model OutcomeSupport {
  id String @id @db.Uuid

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  sessionId String          @map("session_id") @db.Uuid
  session   CoDesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  outcomeType String @map("outcome_type") @db.VarChar(16)
  outcomeId   String @map("outcome_id") @db.Uuid

  basis String @db.VarChar(32)

  /// Present only for `validated_evidence`. `Restrict`, not `Cascade`:
  /// evidence is withdrawn rather than deleted precisely so that what an
  /// outcome relied on stays readable.
  evidenceId String?   @map("evidence_id") @db.Uuid
  evidence   Evidence? @relation("OutcomeSupportEvidence", fields: [evidenceId], references: [id], onDelete: Restrict)

  /// The evidence version validated at link time. Frozen — a later
  /// correction bumps the evidence's own version and leaves this one alone.
  evidenceVersion            Int?    @map("evidence_version")
  evidenceVerificationStatus String? @map("evidence_verification_status") @db.VarChar(16)

  /// Required for `institutional_synthesis`; the domain enforces that.
  rationale String? @db.Text
  note      String? @db.Text

  recordedById String   @map("recorded_by_id") @db.Uuid
  recordedBy   Actor    @relation("OutcomeSupportRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime @map("recorded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([outcomeType, outcomeId])
  @@index([sessionId])
  @@index([evidenceId])
  @@map("outcome_support")
}
