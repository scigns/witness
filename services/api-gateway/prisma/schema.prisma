// Witness — PostgreSQL schema for the Developer Preview.
//
// PostgreSQL is the sole system of record (ADR-0004). Neo4j, OpenSearch and
// pgvector are rebuildable projections and hold no authoritative data; none of
// them appear here because none of them exist yet, and modelling a projection
// before its projector exists would be pretending.
//
// Scope discipline: only the entities the Developer Preview actually uses are
// modelled. Assertion, Evidence, Commitment, Consent and Tenant are all real
// parts of the architecture (architecture/DATA_MODEL.md) and are deliberately
// absent — adding a table nothing writes to is how a schema becomes fiction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Who did something. The human/model distinction is load-bearing: principle P4
/// forbids a model from confirming a record into institutional memory, and that
/// rule is only enforceable if the system can tell them apart.
model Actor {
  id          String   @id @db.Uuid
  kind        String   @db.VarChar(16)
  displayName String   @map("display_name") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  capturedRecords Record[]     @relation("CapturedBy")
  auditEvents     AuditEvent[]

  @@index([kind])
  @@map("actor")
}

/// Where a record came from. Provenance starts here (principle P3).
model Source {
  id         String   @id @db.Uuid
  kind       String   @db.VarChar(32)
  label      String   @db.VarChar(300)
  /// When the source material was created — NOT when Witness ingested it.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  records Record[]

  @@index([occurredAt])
  @@map("source")
}

/// A piece of institutional memory.
///
/// `sourceId` and `capturedById` are NOT NULL by design. A record without
/// provenance is exactly what principle P3 forbids, and the database is the last
/// line of defence for an invariant the application already enforces — because
/// applications get rewritten and this constraint should outlive them.
model Record {
  id           String   @id @db.Uuid
  title        String   @db.VarChar(200)
  body         String   @db.Text
  reviewState  String   @map("review_state") @db.VarChar(24)

  sourceId     String   @map("source_id") @db.Uuid
  source       Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  capturedById String   @map("captured_by_id") @db.Uuid
  capturedBy   Actor    @relation("CapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)

  capturedAt   DateTime @map("captured_at") @db.Timestamptz(6)

  /// Consent grant authorising processing (P2). Nullable ONLY because the consent
  /// service does not exist yet — Phase 3, roadmap 3.4. It becomes NOT NULL then,
  /// and that migration is expected to be the hard one.
  consentGrantId String? @map("consent_grant_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([reviewState])
  @@index([capturedAt])
  @@map("record")
}

/// The tenant boundary (BUILD_ROADMAP.md, Release 0.2, item 1).
///
/// Deliberately minimal: this Developer Preview only covers creation. Membership
/// and multi-tenant scoping of Record/Source are later roadmap items — modelling
/// them now, before anything reads or writes them, would be fiction.
model Organisation {
  id        String   @id @db.Uuid
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspaces      Workspace[]
  memberships     OrganisationMembership[]
  roleAssignments RoleAssignment[]

  @@map("organisation")
}

/// A scoped working area inside an organisation (BUILD_ROADMAP.md, Release 0.2,
/// item 2). Sessions, participants and records are scoped to a workspace in
/// later roadmap items (6, 7, 9) — not yet, since none of those exist here.
///
/// Unlike `AuditEvent.subjectId`, this is a real foreign key: a workspace always
/// belongs to exactly one organisation, never a polymorphic set of parents, so
/// there is no reason to give up referential integrity here.
model Workspace {
  id             String       @id @db.Uuid
  name           String       @db.VarChar(200)

  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships     WorkspaceMembership[]
  roleAssignments RoleAssignment[]

  @@index([organisationId])
  @@map("workspace")
}

/// A registered Witness account (BUILD_ROADMAP.md Milestone 1.1, Users and
/// Memberships). Deliberately independent of `Actor` — see `packages/domain/src/user.ts`
/// for why the two concepts do not merge yet.
///
/// The table is mapped to `witness_user` rather than `user`: Prisma always
/// quotes identifiers so the SQL keyword conflict is not a functional problem,
/// but every other model here reads cleanly as an unquoted `SELECT * FROM x`
/// and there is no reason this one shouldn't too.
model User {
  id           String   @id @db.Uuid
  email        String   @unique @db.VarChar(320)
  displayName  String   @map("display_name") @db.VarChar(200)
  accountState String   @map("account_state") @db.VarChar(24)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisationMemberships OrganisationMembership[]
  workspaceMemberships    WorkspaceMembership[]
  roleAssignments         RoleAssignment[]
  identityLinks           IdentityLink[]
  authSessions            AuthSession[]

  @@index([accountState])
  @@map("witness_user")
}

/// The stable connection between an external identity provider's subject and
/// a Witness user (BUILD_ROADMAP.md Milestone 1.3, Authentication). See
/// `packages/domain/src/identity-link.ts` for why this is keyed on
/// `(provider, providerSubject)` rather than email.
model IdentityLink {
  id              String    @id @db.Uuid
  provider        String    @db.VarChar(32)
  providerSubject String    @map("provider_subject") @db.VarChar(255)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  linkedAt     DateTime  @map("linked_at") @db.Timestamptz(6)
  lastSignInAt DateTime? @map("last_sign_in_at") @db.Timestamptz(6)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("identity_link")
}

/// A signed-in session. `tokenHash` is a SHA-256 hash of the opaque bearer
/// token handed to the browser — the raw token is never persisted, the same
/// reasoning as never storing a password: a database read must not be
/// enough to impersonate a session.
///
/// Delivered as a bearer token rather than a cookie deliberately: the
/// browser already calls the API directly, cross-origin, from a different
/// port (`main.ts`'s CORS configuration predates this capability) — a
/// cross-site cookie would need `SameSite=None; Secure`, which requires
/// HTTPS everywhere including local development. A bearer token sent via
/// `Authorization` header (mirroring the existing, now-superseded-in-
/// production `X-Witness-Dev-User` header shape) avoids that without
/// changing the application's deployment topology.
model AuthSession {
  id        String   @id @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_session")
}

/// A single in-flight OIDC authorization-code-with-PKCE exchange. Short-lived
/// and single-use — the row is deleted the moment the callback completes or
/// fails, so it is intentionally not modelled with the same permanence as
/// everything else in this file. State is stored server-side (rather than
/// signed and round-tripped through the browser) so the callback verifies
/// against something Witness itself wrote, not something it merely trusts a
/// redirect to still contain.
model AuthLoginAttempt {
  /// The OIDC `state` parameter — a high-entropy value the callback must
  /// present unchanged.
  state        String @id @db.VarChar(64)
  nonce        String @db.VarChar(64)
  codeVerifier String @map("code_verifier") @db.VarChar(128)
  redirectUri  String @map("redirect_uri") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("auth_login_attempt")
}

/// "Does this user belong to this organisation" — nothing about what they may
/// do there (that is Milestone 1.2, Roles and Permission Assignment).
///
/// The unique constraint on (organisationId, userId) is the enforcement point
/// for "a user must not have duplicate active membership records for the same
/// organisation": a membership is one row per (organisation, user) pair for
/// its whole lifecycle, transitioning state rather than being recreated.
model OrganisationMembership {
  id             String       @id @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  state String @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organisationId, userId])
  @@index([organisationId, state])
  @@index([userId])
  @@map("organisation_membership")
}

/// "Does this user belong to this workspace". A real foreign key to `Workspace`
/// and `User` — same reasoning as `Workspace.organisationId` — because a
/// workspace membership always has exactly one workspace and one user.
///
/// Nothing here enforces "the user has a valid relationship with the
/// workspace's parent organisation" at the database level — that check reads
/// the user's `OrganisationMembership` for the workspace's `organisationId`,
/// which spans two tables Postgres cannot express as a single constraint. It is
/// enforced in `packages/domain/src/workspace-membership.ts` and the service
/// that reads the organisation membership before calling in.
model WorkspaceMembership {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  state String @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceId, userId])
  @@index([workspaceId, state])
  @@index([userId])
  @@map("workspace_membership")
}

/// "What may this member do here" (BUILD_ROADMAP.md Milestone 1.2, Roles and
/// Permission Assignment) — strictly separate from `OrganisationMembership`/
/// `WorkspaceMembership`, which only answer "does this member belong here".
///
/// One row per (user, scope): `organisationId`/`workspaceId` are mutually
/// exclusive per `scopeType`, enforced by the `role_assignment_scope_check`
/// CHECK constraint added in this model's migration (Prisma's schema DSL has
/// no way to express it directly). The two `@@unique` constraints below give
/// an independent "one row per (organisation, user)" and "one row per
/// (workspace, user)" without a partial index, because Postgres never treats
/// NULL as equal to NULL in a unique constraint — multiple workspace-scoped
/// rows (organisationId = NULL) do not collide with each other, and vice
/// versa.
///
/// Deliberately does not duplicate membership data (state, timestamps) —
/// only the identifiers needed to scope and query the assignment itself; the
/// membership tables above remain the sole source of truth for "in good
/// standing", re-read by the service layer at assignment time
/// (`packages/domain/src/role-assignment.ts`).
model RoleAssignment {
  id        String @id @db.Uuid
  scopeType String @map("scope_type") @db.VarChar(16)

  organisationId String?       @map("organisation_id") @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  workspaceId String?    @map("workspace_id") @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  role String @db.VarChar(24)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organisationId, userId])
  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("role_assignment")
}

/// Append-only, hash-chained audit trail (roadmap 3.7).
///
/// `subjectType` + `subjectId` is a polymorphic association rather than a foreign
/// key to a single table, because the same tamper-evident chain now serves more
/// than one aggregate (Record, Organisation, and more as the roadmap adds
/// aggregates). Postgres cannot express "references exactly one of these tables"
/// as a constraint, so referential integrity here is enforced by the application
/// layer, the same way append-only itself already is — tracked, not forgotten.
///
/// There is deliberately no update or delete path in the application.
model AuditEvent {
  id           String   @id @db.Uuid
  subjectType  String   @map("subject_type") @db.VarChar(24)
  subjectId    String   @map("subject_id") @db.Uuid

  action       String   @db.VarChar(64)

  actorId      String   @map("actor_id") @db.Uuid
  actor        Actor    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)

  /// Null only for the first event in a subject's chain.
  previousHash String?  @map("previous_hash") @db.VarChar(64)
  hash         String   @unique @db.VarChar(64)

  /// Context only — never record content. The audit log answers "who did what,
  /// when", and is retained under a different policy from the content itself.
  metadata     Json     @default("{}")

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectType, subjectId, occurredAt])
  @@map("audit_event")
}
