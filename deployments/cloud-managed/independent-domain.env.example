# Witness independent-domain cutover example — NOT consumed by the pilot
# deployment script. Use only after the coexistence runbook has been approved
# and DNS, tunnel, OIDC, CORS, cookie, and rollback checks are complete.
# No values in this file are secrets.

WITNESS_PUBLIC_URL=https://buildwithwitness.com
WITNESS_WEB_HOST=app.buildwithwitness.com
WITNESS_API_HOST=api.buildwithwitness.com
WITNESS_OIDC_HOST=id.buildwithwitness.com
NEXT_PUBLIC_WITNESS_API_URL=https://api.buildwithwitness.com
NEXT_PUBLIC_WITNESS_BASE_URL=https://api.buildwithwitness.com
WITNESS_WEB_ORIGIN=https://app.buildwithwitness.com
WITNESS_OIDC_REDIRECT_URI=https://api.buildwithwitness.com/api/v1/auth/callback
WITNESS_WEB_BASE_URL=https://app.buildwithwitness.com
NEXT_PUBLIC_WITNESS_BASE_PATH=
OIDC_ISSUER=https://id.buildwithwitness.com/realms/witness
OIDC_PUBLIC_URL=https://id.buildwithwitness.com
