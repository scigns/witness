# Witness — single-node production deployment (docker-compose.pilot.yml).
#
# Minimal on purpose: exactly the variables that compose file reads, nothing
# from the larger dev stack (Neo4j, OpenSearch, Redis, NATS, LiteLLM) that
# this deployment profile does not run. Copy this file to `.env` next to it,
# fill in every value, and never commit the result — `.env` is gitignored.
#
#   cp deployments/cloud-managed/.env.example .env
#
# The independent Witness product-domain contract is documented in
# docs/architecture/INDEPENDENT_PRODUCT_IDENTITY.md. This file remains an
# example only: no DNS or Cloudflare resource is changed by editing it.
# Generate every password with, e.g., `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.

# ── Identity ────────────────────────────────────────────────────────────────
# `sovereign`: zero external network calls, local-only transcription and AI.
# See ADR-0013 for what each profile actually gates.
WITNESS_DEPLOYMENT_PROFILE=sovereign
WITNESS_INSTANCE_NAME="Your Institution — Witness"
WITNESS_DATA_RESIDENCY="Operator-managed host (Your Institution)"
LOG_LEVEL=info

# ── Hostnames — the six lines a domain cutover changes ─────────────────────
WITNESS_PUBLIC_URL=https://buildwithwitness.com
WITNESS_WEB_HOST=app.buildwithwitness.com
WITNESS_API_HOST=api.buildwithwitness.com
WITNESS_OIDC_HOST=id.buildwithwitness.com
NEXT_PUBLIC_WITNESS_API_URL=https://api.buildwithwitness.com
NEXT_PUBLIC_WITNESS_BASE_URL=https://api.buildwithwitness.com
WITNESS_WEB_ORIGIN=https://app.buildwithwitness.com
WITNESS_OIDC_REDIRECT_URI=https://api.buildwithwitness.com/api/v1/auth/callback
WITNESS_WEB_BASE_URL=https://app.buildwithwitness.com
# Only set this if Witness is served under a path (e.g. "/witness") rather
# than a dedicated hostname's root. Leave empty otherwise.
NEXT_PUBLIC_WITNESS_BASE_PATH=

# ── PostgreSQL (ADR-0004: the whole system of record) ───────────────────────
POSTGRES_DB=witness
POSTGRES_USER=witness
POSTGRES_PASSWORD=change-me-in-every-environment
DATABASE_URL=postgresql://witness:${POSTGRES_PASSWORD}@postgres:5432/witness?schema=public

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-every-environment
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-in-every-environment
KEYCLOAK_CLIENT_ID=witness-api
OIDC_ISSUER=https://id.buildwithwitness.com/realms/witness
OIDC_PUBLIC_URL=https://id.buildwithwitness.com
JWT_AUDIENCE=witness-api
WITNESS_REALM_SEED_PASSWORD=change-me-in-every-environment
WITNESS_SESSION_TTL_MINUTES=480

# ── Application limits ───────────────────────────────────────────────────────
WITNESS_MAX_EVIDENCE_ATTACHMENT_MB=200

# ── S3-compatible object storage (StoragePort — Cloudflare R2) ─────────────
# Leave every value below empty to keep the sovereign profile's zero-external-
# call guarantee (ADR-0009) — content stays in Postgres. Only meaningful once
# WITNESS_DEPLOYMENT_PROFILE=hybrid; the API refuses to start with any of
# these set under sovereign.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_MEDIA=
S3_BUCKET_DOCUMENTS=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=
# Per-tenant opt-in is additionally required; this flag alone does not enable egress.
ALLOW_OBJECT_STORAGE_EGRESS=false

# ── Cloudflare Tunnel — no inbound ports opened on the host ────────────────
CLOUDFLARE_TUNNEL_ID=change-me-in-every-environment
