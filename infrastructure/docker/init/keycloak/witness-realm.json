{
  "realm": "witness",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clients": [
    {
      "clientId": "${WITNESS_OIDC_CLIENT_ID:witness-api}",
      "name": "Witness API",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${WITNESS_OIDC_REDIRECT_URI:http://localhost:3001/api/v1/auth/callback}"],
      "webOrigins": ["${WITNESS_WEB_ORIGIN:http://localhost:3000}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WITNESS_WEB_ORIGIN:http://localhost:3000}/*"
      }
    }
  ],
  "users": [
    {
      "username": "witness-dev-tester",
      "email": "roletest@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dev",
      "lastName": "Tester",
      "credentials": [
        {
          "type": "password",
          "value": "${WITNESS_REALM_SEED_PASSWORD:change-me-in-every-environment}",
          "temporary": false
        }
      ]
    },
    {
      "username": "witness-dev-unknown",
      "email": "unregistered@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Unregistered",
      "lastName": "Person",
      "credentials": [
        {
          "type": "password",
          "value": "${WITNESS_REALM_SEED_PASSWORD:change-me-in-every-environment}",
          "temporary": false
        }
      ]
    }
  ]
}
