{
  "name": "@witness/web",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Witness web application (ADR-0002, TECH_STACK).",
  "scripts": {
    "build": "NODE_ENV=production next build",
    "dev": "next dev -p ${WITNESS_WEB_PORT:-3000}",
    "start": "NODE_ENV=production next start -p ${WITNESS_WEB_PORT:-3000}",
    "typecheck": "tsc --noEmit",
