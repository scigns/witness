    "lint": "eslint src",
    "clean": "rm -rf .next dist *.tsbuildinfo"
  },
  "dependencies": {
    "@witness/contracts": "workspace:*",
    "next": "^15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.0"
  }
}
