# ═══════════════════════════════════════════════════════════════════════════════
# Witness — environment configuration template
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# In production, do not use .env files — inject via your secret manager. See
# docs/operations/DEPLOYMENT_GUIDE.md.
#
# The defaults below are the SOVEREIGN defaults: nothing here causes an outbound
# connection to any third party. If you change that, you are making a deliberate
# policy decision and it will be logged and surfaced to your users.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Deployment profile ───────────────────────────────────────────────────────
# sovereign  — no external egress permitted (default; enforced, not advisory)
# hybrid     — external model providers permitted where explicitly configured per tenant
# development— local development conveniences enabled; never use in production
WITNESS_DEPLOYMENT_PROFILE=development
WITNESS_INSTANCE_NAME="Local Development"
# Product landing URL (public metadata; distinct from the authenticated app origin).
WITNESS_PUBLIC_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# Data residency declaration — surfaced to end users in the UI so they can see
# where their words are stored. Free text, e.g. "Australia (ap-southeast-2)".
WITNESS_DATA_RESIDENCY="local development machine"

# ─── Application ports ────────────────────────────────────────────────────────
WITNESS_API_PORT=3001
WITNESS_WEB_PORT=3000
# The browser calls the API directly, so this must be reachable from the browser,
# not from the container. NEXT_PUBLIC_ prefixed values are compiled into the
# client bundle — never put a secret behind this prefix.
NEXT_PUBLIC_WITNESS_API_URL=http://localhost:3001
# Which deployment the *frontend bundle* is built for. Compiled in at build
# time, like the URL above. It gates one thing: whether the unverified
# X-Witness-Dev-User header may be sent at all, and whether the Developer
# Preview banner and role switcher are rendered. Set it to the same value as
# WITNESS_DEPLOYMENT_PROFILE.
NEXT_PUBLIC_WITNESS_PROFILE=development
# Where the web application is served from, when that is not the root of its
# origin — e.g. `/witness` on a domain whose `/` is another site. Compiled into
# every asset URL and route at build time, so it is a build argument, not a
# runtime value. Empty means "a dedicated hostname", which is the default.
NEXT_PUBLIC_WITNESS_BASE_PATH=
# The exact origin the browser sends, used for the API's CORS policy. Derived from
# WITNESS_WEB_PORT when empty. Set it explicitly when Witness is reached through a
# hostname or a reverse proxy rather than localhost — a mismatch is refused by the
# browser before the request reaches Witness, and the error names CORS rather than
# the port that was actually changed.
WITNESS_WEB_ORIGIN=
# Where the API sends a signed-in browser after the OIDC callback. Empty means
# the root of WITNESS_WEB_ORIGIN. Set it — including the path — when Witness is
# served under one, or the callback lands on whatever else that origin serves.
# Must be the same origin as WITNESS_WEB_ORIGIN; the API refuses to start
# otherwise, because that redirect carries a live session token.
WITNESS_WEB_BASE_URL=

# ─── PostgreSQL — system of record ────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=witness
POSTGRES_USER=witness
POSTGRES_PASSWORD=change-me-in-every-environment
DATABASE_URL=postgresql://witness:change-me-in-every-environment@localhost:5432/witness?schema=public
DATABASE_POOL_MAX=20
DATABASE_SSL_MODE=prefer

# ─── Neo4j — knowledge graph projection ───────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-every-environment
NEO4J_DATABASE=witness

# ─── OpenSearch — lexical search projection ───────────────────────────────────
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=change-me-in-every-environment
OPENSEARCH_INDEX_PREFIX=witness

# ─── Redis — cache, rate limiting, job coordination ───────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=witness

# ─── MinIO / S3 — media and document object storage ───────────────────────────
# Same egress shape as EXTERNAL_MODEL_*: a non-empty S3_ENDPOINT/S3_ACCESS_KEY_ID
# while WITNESS_DEPLOYMENT_PROFILE=sovereign is a startup error, by design
# (ADR-0009 — recordings and documents are institutional content too, not just
# AI inference). Leave S3_ENDPOINT empty to use Postgres-inline storage instead
# (StoragePort's other adapter, and the sovereign profile's default).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=witness
S3_SECRET_ACCESS_KEY=change-me-in-every-environment
S3_BUCKET_MEDIA=witness-media
S3_BUCKET_DOCUMENTS=witness-documents
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256
# Per-tenant opt-in is additionally required; this flag alone does not enable egress.
ALLOW_OBJECT_STORAGE_EGRESS=false

# ─── NATS JetStream — event transport (see ADR-0005) ──────────────────────────
NATS_URL=nats://localhost:4222
NATS_STREAM_PREFIX=WITNESS

# ─── Keycloak — identity provider (see ADR-0007) ──────────────────────────────
# Bootstrap admin for the local container. Not a Witness user — Witness users live
# in the realm, and the realm is provisioned from source (infrastructure/docker/init/keycloak).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-every-environment
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=witness
KEYCLOAK_CLIENT_ID=witness-api
KEYCLOAK_CLIENT_SECRET=change-me-in-every-environment
OIDC_ISSUER=http://localhost:8080/realms/witness
JWT_AUDIENCE=witness-api
# Where Keycloak (or the development identity-provider double) redirects back to after
# sign-in. Optional — derived from WITNESS_API_PORT if unset.
# WITNESS_OIDC_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback
# How long a Witness session lasts before it must be renewed by signing in again (minutes).
WITNESS_SESSION_TTL_MINUTES=480
# Session and token lifetimes (seconds)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=28800

# ─── Authorisation ────────────────────────────────────────────────────────────
CASBIN_MODEL_PATH=./packages/policy/model.conf
# Deny-by-default is not configurable. This is here to be explicit about it.
AUTHZ_DEFAULT_EFFECT=deny

# ─── AI platform (see ADR-0009) ───────────────────────────────────────────────
# Default: everything runs locally via Ollama. No data leaves the boundary.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=change-me-in-every-environment
OLLAMA_BASE_URL=http://localhost:11434

MODEL_EXTRACTION=ollama/llama3.3:70b-instruct
MODEL_SUMMARISATION=ollama/llama3.3:70b-instruct
MODEL_EMBEDDING=ollama/bge-m3
EMBEDDING_DIMENSIONS=1024

# External model providers. Leave EMPTY in the sovereign profile — a non-empty value
# here while WITNESS_DEPLOYMENT_PROFILE=sovereign is a startup error, by design.
EXTERNAL_MODEL_PROVIDER=
EXTERNAL_MODEL_API_KEY=
EXTERNAL_MODEL_BASE_URL=
# Per-tenant opt-in is additionally required; this flag alone does not enable egress.
ALLOW_EXTERNAL_MODEL_EGRESS=false

# ─── Transcription ────────────────────────────────────────────────────────────
WHISPER_ENDPOINT=http://localhost:9001
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8
DIARISATION_ENABLED=true
# Comma-separated ISO-639-1 codes, or `auto`
TRANSCRIPTION_LANGUAGES=auto

# ─── Consent & retention (see docs/governance/CONSENT_FRAMEWORK.md) ───────────
# Processing without a valid consent grant is impossible; these tune the policy,
# they do not disable it.
CONSENT_REQUIRED=true
CONSENT_DEFAULT_EXPIRY_DAYS=1825
# How quickly a revocation must be reflected in every projection (seconds)
CONSENT_REVOCATION_SLO_SECONDS=300
RETENTION_DEFAULT_DAYS=3650
RETENTION_MEDIA_DAYS=1825

# ─── Observability ────────────────────────────────────────────────────────────
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-every-environment
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=witness
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
# Telemetry NEVER leaves your infrastructure. There is no upstream collector and
# we will not add one. See docs/governance/DIGITAL_SOVEREIGNTY.md.
TELEMETRY_EXTERNAL_REPORTING=false

# ─── Limits ───────────────────────────────────────────────────────────────────
# Caps one evidence audio attachment; multer enforces it before the bytes reach
# the database. Read by the api service — see docker-compose.pilot.yml.
WITNESS_MAX_EVIDENCE_ATTACHMENT_MB=200
MAX_GRAPH_TRAVERSAL_DEPTH=6
MAX_SEARCH_RESULTS=200
RATE_LIMIT_PER_MINUTE=120

# ─── Deployed pilot — hostnames and TLS ───────────────────────────────────────
# Only used by deployments/cloud-managed/docker-compose.pilot.yml. Names, never
# secrets: the domain is the operator's, and the certificates are obtained by
# Caddy over ACME.
# WITNESS_WEB_HOST=pilot.example.org
# WITNESS_API_HOST=api.pilot.example.org
# WITNESS_OIDC_HOST=id.pilot.example.org
# OIDC_PUBLIC_URL=https://id.pilot.example.org
# WITNESS_ACME_EMAIL=operations@example.org
# Keycloak's own database, separate from Witness's.
# KEYCLOAK_DB=keycloak
# KEYCLOAK_DB_USER=keycloak
# KEYCLOAK_DB_PASSWORD=
# Substituted into the realm import so the client's redirect URI and web origin
# are the deployed ones. The seed password belongs to the two development test
# users the realm defines; give it a real value or remove those users.
# WITNESS_REALM_SEED_PASSWORD=

# ─── First run — bootstrap and invitations ────────────────────────────────────
# `pnpm bootstrap` creates the first organisation and invites its first
# administrator. Deny-by-default means no HTTP request can create them, so this
# is the one operation performed outside the application. It refuses to run once
# any organisation exists.
# WITNESS_BOOTSTRAP_ORGANISATION_NAME="Your Institution"
# WITNESS_BOOTSTRAP_ADMIN_EMAIL=
# WITNESS_BOOTSTRAP_ADMIN_NAME=
#
# `pnpm invite` adds a colleague to an existing organisation. Also an operator
# command: `user:create` has no scope to resolve in and stays out of reach of
# every real signed-in session until a platform-administrator concept exists.
# Either way the account is inert until that person signs in through the
# identity provider with a *verified* email that matches.
# WITNESS_INVITE_ORGANISATION="Your Institution"
# WITNESS_INVITE_EMAIL=
# WITNESS_INVITE_NAME=
# WITNESS_INVITE_ROLE=contributor

# ─── Cloudflare Email Routing (operator utility only) ─────────────────────────
# Leave empty in this template. Supply through the operator environment or
# GitHub encrypted secrets; never place production credentials or destinations here.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
WITNESS_EMAIL_ROUTING_DESTINATION=

# ─── Billing profile (C3 invoice/remittance configuration) ───────────────────
# Placeholders only. Remittance values must be supplied through deployment
# secrets and are shown only on authenticated invoice/payment pages.
# BILLING_LEGAL_NAME=
# BILLING_ABN=
# BILLING_EMAIL=
# BILLING_BANK_ACCOUNT_NAME=
# BILLING_BANK_BSB=
# BILLING_BANK_ACCOUNT_NUMBER=

# ─── Cloudflare Tunnel (deployments/cloud-managed/docker-compose.pilot.yml) ───
# Used by the `cloudflare` compose profile. The connector dials out, so the host
# needs no public IP and no open port; PostgreSQL has no ingress rule and
# therefore no public hostname at all.
#
# `cloudflared tunnel create witness-pilot` prints the id and writes the
# credentials file. That file is a secret: mount it, never commit it.
# CLOUDFLARE_TUNNEL_ID=
